/.codegenie/
/.appanalyzer/
/.hvigor/
/.playwright-cli/
/.workbuddy/
/.secrets/
/.superpowers/
/*.bat

**/build/
**/.test/
.cxx/
/dist/

/docs/*
!/docs/screenshots/

**/AGENTS.md
__pycache__/
*.pyc
